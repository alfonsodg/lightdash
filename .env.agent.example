# Agent BI extension example environment (Phase 1). Placeholders only:
# copy to .env.agent and fill in real values; never commit real secrets.
#
# Scope: these vars are operational configuration only (database schema name,
# LLM endpoint/credentials/model, row/timeout caps). They do NOT control the
# rollout: enablement uses the `agent-bi` feature flag, off by default, resolved
# per request with Console overrides and generic self-hosted ENV lists applied.
# Precedence: AGENT_BI_* values override the built-in defaults shown below.
# Refresh: the server reads this config once at startup, so restart the
# lightdash service after any change.
AGENT_BI_SCHEMA=agent_ext
#AGENT_BI_LLM_ENDPOINT=
#AGENT_BI_LLM_API_KEY=
#AGENT_BI_MODEL=
AGENT_BI_MAX_ROWS=1000
AGENT_BI_TIMEOUT_MS=30000
AGENT_BI_LOG_LEVEL=info
